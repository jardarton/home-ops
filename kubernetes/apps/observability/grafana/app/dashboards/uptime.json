      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success == 1)",
          "legendFormat": "Up",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success == 0) or vector(0)",
          "legendFormat": "Down",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(avg_over_time(probe_success[$__range]))",
          "legendFormat": "Availability",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(probe_duration_seconds{job!~\".*/(dns|nfs)\"})",
          "legendFormat": "Avg response",
          "instant": true,
          "range": false
        }
      ]
