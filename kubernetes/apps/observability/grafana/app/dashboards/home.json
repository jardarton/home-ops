      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", severity=~\"critical|warning\", alertname!~\"Watchdog|InfoInhibitor|CephNodeNetworkPacketDrops\"}) or vector(0)",
          "legendFormat": "Alerts",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(probe_success == 0) or vector(0)",
          "legendFormat": "Services",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(kube_node_status_condition{condition=\"Ready\", status=\"true\"} == 0) or vector(0)",
          "legendFormat": "Nodes",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(min by (kubernetes_node) (time() - node_boot_time_seconds) < 86400) or vector(0)",
          "legendFormat": "Rebooted (24h)",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(ceph_health_status)",
          "legendFormat": "Ceph",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(flux_resource_info{ready=\"False\", suspended=\"False\"}) or vector(0)",
          "legendFormat": "Flux",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(time() - kube_cronjob_status_last_successful_time{namespace=\"database\", cronjob=~\".+-pgdump\"} > 26 * 3600) or vector(0)) + (sum(volsync_volume_out_of_sync{role=\"source\"}) or vector(0))",
          "legendFormat": "Backups",
          "instant": true,
          "range": false
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(certmanager_certificate_expiration_timestamp_seconds - time()) / 86400",
          "legendFormat": "Certificate",
          "instant": true,
          "range": false
        }
      ]
