      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort(time() - label_join(label_replace(label_replace(label_replace(label_join(ALERTS_FOR_STATE{severity=~\"critical|warning\", alertname!~\"Watchdog|InfoInhibitor|CephNodeNetworkPacketDrops\"} and ignoring (alertstate) ALERTS{alertstate=\"firing\"}, \"_t\", \";\", \"name\", \"pod\", \"instance\", \"namespace\"), \"target\", \"$1\", \"_t\", \";*([^;]+).*\"), \"target\", \"$1\", \"target\", \"https?://([^./]+).*\"), \"target\", \"$1\", \"target\", \"(.+)-[a-z0-9]{8,10}-[a-z0-9]{5}\"), \"alert\", \" \u00b7 \", \"alertname\", \"target\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "severity",
                "alert",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "severity": 0,
              "alert": 1,
              "Value": 2
            },
            "renameByName": {
              "severity": " ",
              "alert": "Alert",
              "Value": "Since"
            }
          }
        }
      ],
      "links": [
        {
          "title": "All alerts",
          "url": "https://alertmanager.${SECRET_DOMAIN}/#/alerts"
        }
      ]
