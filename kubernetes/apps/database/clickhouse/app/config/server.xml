<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
        <log remove="1"/>
        <errorlog remove="1"/>
    </logger>

    <!-- Sized for a 4Gi container; ClickHouse otherwise assumes the whole node. -->
    <max_server_memory_usage>3435973836</max_server_memory_usage>
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>67108864</index_mark_cache_size>
    <uncompressed_cache_size>67108864</uncompressed_cache_size>
    <query_cache>
        <max_size_in_bytes>67108864</max_size_in_bytes>
    </query_cache>
    <max_concurrent_queries>32</max_concurrent_queries>

    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>

    <!-- Keep the query log briefly; drop the other system logs, which would
         otherwise outgrow the captured data. -->
    <query_log>
        <ttl>event_date + INTERVAL 14 DAY DELETE</ttl>
    </query_log>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <query_thread_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <blob_storage_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
</clickhouse>
